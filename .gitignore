# =============================================================================
# GITIGNORE - PARQUEADERO AUTOS COLOMBIA
# Protección de datos sensibles y exclusión de artefactos de desarrollo
# =============================================================================

# Dependencias de Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Variables de entorno y secretos (NUNCA SUBIR A CONTROL DE VERSIONES)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Logs y depuración
logs/
*.log

# Archivos temporales y de sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Carpetas de editores e IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Archivos de empaquetado y construcción
dist/
build/
out/
.cache/
tmp/
scratch/
